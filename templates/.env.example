# Environment variables for {{PROJECT_NAME}}
#
# Rules (see core/security.mdc):
# - This file is committed. It lists every variable the app reads, with a
#   description and NO real value. Real values live in .env.local (gitignored)
#   or the deployment platform's secret store.
# - Public/client-exposed variables carry the framework prefix (NEXT_PUBLIC_,
#   EXPO_PUBLIC_, VITE_) and must never hold a secret.
# - Add a new variable here in the same PR that introduces it, and document it
#   in the deployment docs.
# - Config validation at boot must fail fast when a required variable is
#   missing or malformed (see core/error-handling.mdc, "Fatal").

# --- Runtime ---------------------------------------------------------------
NODE_ENV=                     # development | test | production
APP_ENV=                      # development | preview | staging | production
APP_URL=                      # Public base URL of this deployment, no trailing slash
LOG_LEVEL=                    # trace | debug | info | warn | error

# --- Database --------------------------------------------------------------
DATABASE_URL=                 # Pooled connection string (application queries)
DIRECT_DATABASE_URL=          # Direct connection (migrations only)

# --- Auth ------------------------------------------------------------------
AUTH_SECRET=                  # Session/JWT signing secret, >= 32 random bytes
AUTH_URL=                     # Canonical auth callback base URL

# --- Third-party services (one block per service) --------------------------
# {{SERVICE}}_API_KEY=        # Server-only
# {{SERVICE}}_WEBHOOK_SECRET= # Used to verify inbound webhook signatures

# --- Observability ---------------------------------------------------------
ERROR_DSN=                    # Server-side error tracker DSN
NEXT_PUBLIC_ERROR_DSN=        # Client error tracker DSN (public by design)
TRACES_SAMPLE_RATE=           # 1.0 dev, ~0.5 preview, ~0.1 production
PROFILES_SAMPLE_RATE=         # same guidance as traces
RELEASE=                      # Set by CI to the commit SHA

# --- Public (client-exposed, never secrets) --------------------------------
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_FEATURE_FLAGS_KEY=
